{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Knowledge": {
    "PackDirectory": "fixtures/vendor-knowledge",
    "MaxFacts": 10
  },
  "Fixtures": {
    "TwinDirectory": "fixtures/telecom-lab"
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Diagnostics": {
    "Mode": "Simulated",
    "Targets": {
      "lab-node-a": "http://127.0.0.1:5199/health"
    },
    "ReplayDirectory": "fixtures/telecom-lab/replay",
    "MaxResponseBytes": 65536
  },
  "Muse": {
    "Model": "muse-spark-1.3",
    "ReasoningEffort": "low",
    "MaxOutputTokens": 6000
  }
}
