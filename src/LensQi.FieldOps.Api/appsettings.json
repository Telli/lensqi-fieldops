{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Knowledge": {
    "PackDirectory": "fixtures/vendor-knowledge",
    "MaxFacts": 10
  },
  "Fixtures": {
    "TwinDirectory": "fixtures/telecom-lab"
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Diagnostics": {
    "Mode": "Simulated",
    "Targets": {
      "lab-node-a": "http://127.0.0.1:5199/health"
    },
    "ReplayDirectory": "fixtures/telecom-lab/replay",
    "MaxResponseBytes": 65536
  },
  "Muse": {
    "Model": "muse-spark-1.3",
    "ReasoningEffort": "low",
    "MaxOutputTokens": 6000
  },
  "Voice": {
    "Model": "muse-voice-transcribe-1.0",
    "TimeoutSeconds": 60
  },
  "Speech": {
    "VoiceId": "hGVeHdJEcfHv6D6RUSiY",
    "Model": "eleven_flash_v2_5",
    "OutputFormat": "mp3_44100_64",
    "TimeoutSeconds": 8,
    "MaxCharacters": 1500
  },
  "Sam": {
    "Model": "sam-3.1",
    "MaskEncoding": "one_bit",
    "IncludeConfidence": true,
    "PythonExecutable": "python3",
    "SidecarDirectory": "tools/sam-parser",
    "CropPadFraction": 0.25,
    "SidecarTimeoutSeconds": 30
  },
  "Hardening": {
    "ModelRequestTimeoutSeconds": 90,
    "ModelCallsPerInspection": 30,
    "ModelCallsPerTask": 150,
    "InspectionWindowHours": 24,
    "ModelCallsPerHourPerIp": 120,
    "VoiceInputCallsPerHourPerIp": 600,
    "SpeechCallsPerHourPerIp": 600,
    "MinImageShortSide": 240,
    "MinImageLongSide": 320,
    "MaxImagePixels": 50000000
  },
  "LiveVision": {
    "DetectionIntervalMs": 4000,
    "GuidanceIntervalMs": 12000,
    "TimeoutSeconds": 20,
    "RequestsPerMinute": 30
  },
  "ChangeEvidence": {
    "ThresholdsVersion": "visual-change/1",
    "DuplicateMaxHashDistance": 3,
    "ChangeMinHashDistance": 12,
    "ChangeMaxIoU": 0.8,
    "ChangeMinCentroidShift": 0.1,
    "MinMaskPixels": 200
  }
}
